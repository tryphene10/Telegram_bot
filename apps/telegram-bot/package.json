{
  "name": "@arcc/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@arcc/ai": "workspace:*",
    "@arcc/api": "workspace:*",
    "@arcc/database": "workspace:*",
    "@arcc/knowledge": "workspace:*",
    "@arcc/policies": "workspace:*",
